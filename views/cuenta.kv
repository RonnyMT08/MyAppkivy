<CuentaView>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(10)

        Label:
            text: "Mi Cuenta"
            font_size: sp(28)
            size_hint_y: None
            height: dp(50)
            halign: "left"
            valign: "middle"
            text_size: self.size
            font_name: "assets/fonts/RobotoSlab-Bold.ttf"
            color: TEXT_PRIMARY

        ScrollView:
            GridLayout:
                cols: 1
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(180)
                    padding: dp(20)
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: (*PRIMARY[:3], 0.1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]

                    Label:
                        text: "Juan Pérez"
                        font_size: sp(24)
                        font_name: "assets/fonts/RobotoSlab-Bold.ttf"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: dp(35)
                        color: TEXT_PRIMARY

                    Label:
                        text: "juan@email.com"
                        font_size: sp(16)
                        color: TEXT_SECONDARY
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: dp(25)

                    Label:
                        text: "+54 9 11 1234-5678"
                        font_size: sp(16)
                        color: TEXT_SECONDARY
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: dp(25)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(20)
                        Label:
                            text: "Nivel: Intermedio"
                            font_size: sp(14)
                            color: PRIMARY
                        Label:
                            text: "Partidos: 23"
                            font_size: sp(14)
                            color: PRIMARY
                        Label:
                            text: "Victorias: 11"
                            font_size: sp(14)
                            color: PRIMARY

                Label:
                    text: "Editar Datos"
                    font_size: sp(20)
                    font_name: "assets/fonts/RobotoSlab-Bold.ttf"
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    size_hint_y: None
                    height: dp(35)
                    color: TEXT_PRIMARY

                TextInput:
                    id: edit_nombre
                    text: "Juan Pérez"
                    hint_text: "Nombre"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    padding: [15, 15]

                TextInput:
                    id: edit_email
                    text: "juan@email.com"
                    hint_text: "Email"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    padding: [15, 15]

                TextInput:
                    id: edit_telefono
                    text: "+54 9 11 1234-5678"
                    hint_text: "Teléfono"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    input_filter: "int"
                    padding: [15, 15]

                Button:
                    text: "Guardar Cambios"
                    size_hint_y: None
                    height: dp(50)
                    background_normal: ""
                    background_color: PRIMARY
                    on_press: root.guardar_cambios(edit_nombre.text, edit_email.text, edit_telefono.text)

        Button:
            text: "Cerrar Sesión"
            size_hint_y: None
            height: dp(50)
            background_normal: ""
            background_color: ERROR
            on_press: root.cerrar_sesion()
