<MapasView>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(10)

        Label:
            text: "Campos de Juego"
            font_size: sp(28)
            size_hint_y: None
            height: dp(50)
            halign: "left"
            valign: "middle"
            text_size: self.size
            font_name: "assets/fonts/RobotoSlab-Bold.ttf"
            color: TEXT_PRIMARY

        ScrollView:
            GridLayout:
                cols: 1
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(200)
                    padding: dp(15)
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: BG_CARD
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]

                    BoxLayout:
                        size_hint_y: None
                        height: dp(30)
                        Label:
                            text: "Campo Central"
                            font_size: sp(18)
                            font_name: "assets/fonts/RobotoSlab-Bold.ttf"
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.7
                            color: TEXT_PRIMARY
                        Label:
                            text: "5 km"
                            font_size: sp(14)
                            color: PRIMARY
                            halign: "right"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.3

                    Image:
                        source: "assets/images/mapa1.png"
                        size_hint_y: None
                        height: dp(50)

                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(10)

                        Label:
                            text: "Av. Principal 123"
                            font_size: sp(14)
                            color: TEXT_SECONDARY
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.6

                        Button:
                            text: "Cómo llegar"
                            size_hint_x: 0.4
                            height: dp(40)
                            background_normal: ""
                            background_color: PRIMARY
                            on_press: import webbrowser; webbrowser.open("https://maps.google.com/?q=Av.+Principal+123")

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(200)
                    padding: dp(15)
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: BG_CARD
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]

                    BoxLayout:
                        size_hint_y: None
                        height: dp(30)
                        Label:
                            text: "Bosque Norte"
                            font_size: sp(18)
                            font_name: "assets/fonts/RobotoSlab-Bold.ttf"
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.7
                            color: TEXT_PRIMARY
                        Label:
                            text: "12 km"
                            font_size: sp(14)
                            color: PRIMARY
                            halign: "right"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.3

                    Image:
                        source: "assets/images/mapa2.png"
                        size_hint_y: None
                        height: dp(50)

                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(10)

                        Label:
                            text: "Ruta 4, km 20"
                            font_size: sp(14)
                            color: TEXT_SECONDARY
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.6

                        Button:
                            text: "Cómo llegar"
                            size_hint_x: 0.4
                            height: dp(40)
                            background_normal: ""
                            background_color: PRIMARY
                            on_press: import webbrowser; webbrowser.open("https://maps.google.com/?q=Ruta+4+km+20")

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(200)
                    padding: dp(15)
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: BG_CARD
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]

                    BoxLayout:
                        size_hint_y: None
                        height: dp(30)
                        Label:
                            text: "Zona Sur"
                            font_size: sp(18)
                            font_name: "assets/fonts/RobotoSlab-Bold.ttf"
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.7
                            color: TEXT_PRIMARY
                        Label:
                            text: "8 km"
                            font_size: sp(14)
                            color: PRIMARY
                            halign: "right"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.3

                    Image:
                        source: "assets/images/mapa3.png"
                        size_hint_y: None
                        height: dp(50)

                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(10)

                        Label:
                            text: "Calle 8 #456"
                            font_size: sp(14)
                            color: TEXT_SECONDARY
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_x: 0.6

                        Button:
                            text: "Cómo llegar"
                            size_hint_x: 0.4
                            height: dp(40)
                            background_normal: ""
                            background_color: PRIMARY
                            on_press: import webbrowser; webbrowser.open("https://maps.google.com/?q=Calle+8+456")
