<ReservasView>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(10)

        Label:
            text: "Reservar"
            font_size: sp(28)
            size_hint_y: None
            height: dp(50)
            halign: "left"
            valign: "middle"
            text_size: self.size
            font_name: "assets/fonts/RobotoSlab-Bold.ttf"
            color: TEXT_PRIMARY

        ScrollView:
            GridLayout:
                cols: 2
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: "Nombre"
                    font_size: sp(16)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                    color: TEXT_PRIMARY

                TextInput:
                    id: nombre
                    hint_text: "Tu nombre"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    padding: [15, 15]

                Label:
                    text: "Apellido"
                    font_size: sp(16)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                    color: TEXT_PRIMARY

                TextInput:
                    id: apellido
                    hint_text: "Tu apellido"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    padding: [15, 15]

                Label:
                    text: "Teléfono"
                    font_size: sp(16)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                    color: TEXT_PRIMARY

                TextInput:
                    id: telefono
                    hint_text: "Tu teléfono"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    input_filter: "int"
                    padding: [15, 15]

                Label:
                    text: "Fecha"
                    font_size: sp(16)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                    color: TEXT_PRIMARY

                TextInput:
                    id: fecha
                    hint_text: "DD/MM/AAAA"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    padding: [15, 15]

                Label:
                    text: "Hora"
                    font_size: sp(16)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                    color: TEXT_PRIMARY

                TextInput:
                    id: hora
                    hint_text: "HH:MM"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    padding: [15, 15]

                Label:
                    text: "Personas"
                    font_size: sp(16)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                    color: TEXT_PRIMARY

                TextInput:
                    id: personas
                    hint_text: "N° de personas"
                    size_hint_y: None
                    height: dp(50)
                    multiline: False
                    input_filter: "int"
                    padding: [15, 15]

        Button:
            text: "Confirmar Reserva"
            size_hint_y: None
            height: dp(55)
            background_normal: ""
            background_color: PRIMARY
            on_press: root.confirmar_reserva(nombre.text, apellido.text, telefono.text, fecha.text, hora.text, personas.text)

        Button:
            text: "Cancelar"
            size_hint_y: None
            height: dp(45)
            background_normal: ""
            background_color: ERROR
            on_press: root.cancelar_reserva("RES-001")
